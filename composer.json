{
    "name": "fof/recaptcha",
    "description": "Increase your forum's security with Google reCAPTCHA",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/recaptcha/issues",
        "source": "https://github.com/FriendsOfFlarum/recaptcha",
        "forum": "https://discuss.flarum.org/d/18399"
    },
    "homepage": "https://friendsofflarum.org/",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-rc.3",
        "google/recaptcha": "^1.3 || ^2.0"
    },
    "authors": [
        {
            "name": "FoF Team",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\ReCaptcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\ReCaptcha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF reCAPTCHA",
            "category": "feature",
            "icon": {
                "name": "fas fa-robot",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof/oauth",
                "ianm/twofactor"
            ]
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/18399"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:setup": "@php tests/integration/setup.php",
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
